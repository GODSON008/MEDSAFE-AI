# MedSafe AI Environment Variables

# Add your Gemini API key here to enable the trained Gemini Multimodal AI.
# The app will fall back to local rule-based parsing if this is not provided.
GEMINI_API_KEY=your_gemini_api_key_here

# Google OAuth2 Client ID for "Sign in with Google"
# Get from: https://console.cloud.google.com/ → APIs & Services → Credentials → Create OAuth 2.0 Client ID
# Set authorized JS origins to: http://localhost:8000 and http://127.0.0.1:8000
GOOGLE_CLIENT_ID=your_google_oauth_client_id_here.apps.googleusercontent.com

# JWT Secret Key — used to sign and verify session tokens. KEEP THIS SECRET.
# Generate one with: python3 -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=replace_with_a_long_random_secret_string
